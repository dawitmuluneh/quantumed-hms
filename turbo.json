{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "ENCRYPTION_MASTER_KEY",
    "AUDIT_HASH_PEPPER",
    "SUPER_ADMIN_BOOTSTRAP_EMAIL",
    "SUPER_ADMIN_BOOTSTRAP_PASSWORD",
    "DEMO_HOSPITAL_SLUG",
    "API_BASE_URL",
    "API_INTERNAL_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "JITSI_DOMAIN",
    "JITSI_APP_ID",
    "JITSI_JWT_SECRET",
    "STRIPE_API_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SMS_PROVIDER",
    "SMS_TWILIO_ACCOUNT_SID",
    "SMS_TWILIO_AUTH_TOKEN",
    "SMS_TWILIO_FROM",
    "SMTP_URL",
    "SMTP_FROM",
    "OBJECT_STORAGE_ENDPOINT",
    "OBJECT_STORAGE_BUCKET",
    "OBJECT_STORAGE_ACCESS_KEY",
    "OBJECT_STORAGE_SECRET_KEY",
    "AI_TRIAGE_PROVIDER",
    "OPENAI_API_KEY",
    "OTEL_EXPORTER_OTLP_ENDPOINT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}

# =============================================================================
# QuantuMed HMS — Environment Variables (example)
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` itself.

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT_API=4000
PORT_WEB=3000

# -----------------------------------------------------------------------------
# PostgreSQL 16 (multi-schema tenancy)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://quantumed:quantumed@localhost:5432/quantumed_hms?schema=platform

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth secrets
# -----------------------------------------------------------------------------
# CHANGE THESE before any non-development deployment.
JWT_ACCESS_SECRET=dev-access-secret-please-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# -----------------------------------------------------------------------------
# Field-level encryption (PHI columns)
# -----------------------------------------------------------------------------
# 32-byte base64-encoded master key. Generate with:
#   openssl rand -base64 32
ENCRYPTION_MASTER_KEY=ZGV2LWVuY3J5cHRpb24tbWFzdGVyLWtleS1jaGFuZ2UtbWUtMzI=
AUDIT_HASH_PEPPER=dev-audit-pepper-change-me

# -----------------------------------------------------------------------------
# Bootstrap super admin (one-time, used by `pnpm db:seed`)
# -----------------------------------------------------------------------------
SUPER_ADMIN_BOOTSTRAP_EMAIL=superadmin@quantumed.local
SUPER_ADMIN_BOOTSTRAP_PASSWORD=ChangeMeOnFirstLogin!1
DEMO_HOSPITAL_SLUG=demo

# -----------------------------------------------------------------------------
# API <-> Web wiring
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Integrations — STUBBED in Phase A. Provide real values when implementing
# the relevant module.
# -----------------------------------------------------------------------------
# Jitsi (telemedicine)
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_JWT_SECRET=

# Stripe (billing)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS adapter (use Twilio or any regional gateway)
SMS_PROVIDER=stub
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# SMTP / SES
SMTP_URL=smtp://maildev:1025
SMTP_FROM=no-reply@quantumed.local

# Object storage (S3-compatible — MinIO for local)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=quantumed-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# AI / ML triage adapter
AI_TRIAGE_PROVIDER=stub
OPENAI_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

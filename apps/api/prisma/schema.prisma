// QuantuMed HMS — Phase A platform schema.
//
// Tenancy strategy (per ADR-0001):
//   - `platform` schema holds cross-tenant entities (hospitals, super-admin
//     users, packages, subscriptions, audit log of platform-level events).
//   - Per-tenant clinical schemas (`tenant_<slug>`) are provisioned at hospital
//     onboarding time by TenantProvisioningService. Phase A creates these
//     schemas but does not yet populate clinical tables — that lands in Phase B
//     when patients/encounters/etc. migrate out of the platform schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform"]
}

// =============================================================================
// Platform schema
// =============================================================================

enum HospitalTier {
  STANDARD
  PREMIUM
  ENTERPRISE

  @@schema("platform")
}

enum IsolationMode {
  SCHEMA
  DATABASE

  @@schema("platform")
}

enum HospitalStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@schema("platform")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LOCKED

  @@schema("platform")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@schema("platform")
}

model Hospital {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  tier                 HospitalTier   @default(STANDARD)
  isolationMode        IsolationMode  @default(SCHEMA)
  schemaName           String         @unique @map("schema_name")
  databaseUrl          String?        @map("database_url")
  defaultLocale        String         @default("en") @map("default_locale")
  defaultTimezone      String         @default("UTC") @map("default_timezone")
  defaultCurrency      String         @default("USD") @map("default_currency")
  branding             Json?
  status               HospitalStatus @default(PROVISIONING)
  passwordRotationDone Boolean        @default(false) @map("password_rotation_done")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  users         User[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]

  @@map("hospitals")
  @@schema("platform")
}

model Package {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  priceCents  Int      @map("price_cents")
  currency    String   @default("USD")
  intervalDays Int     @default(30) @map("interval_days")
  features    Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("packages")
  @@schema("platform")
}

model Subscription {
  id           String   @id @default(cuid())
  hospitalId   String   @map("hospital_id")
  packageId    String   @map("package_id")
  status       String   @default("active")
  startsAt     DateTime @default(now()) @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  stripeSubId  String?  @map("stripe_subscription_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  package  Package  @relation(fields: [packageId], references: [id])

  @@index([hospitalId])
  @@map("subscriptions")
  @@schema("platform")
}

model User {
  id                String     @id @default(cuid())
  hospitalId        String?    @map("hospital_id")
  email             String
  emailNormalized   String     @map("email_normalized")
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  status            UserStatus @default(ACTIVE)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEnc      String?    @map("mfa_secret_enc")
  mustRotatePassword Boolean   @default(false) @map("must_rotate_password")
  lastLoginAt       DateTime?  @map("last_login_at")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  hospital      Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([hospitalId, emailNormalized])
  @@index([hospitalId])
  @@index([emailNormalized])
  @@map("users")
  @@schema("platform")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@map("roles")
  @@schema("platform")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
  @@schema("platform")
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  familyId    String   @map("family_id")
  tokenHash   String   @unique @map("token_hash")
  issuedAt    DateTime @default(now()) @map("issued_at")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedById String? @map("replaced_by_id")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("platform")
}

// Append-only audit log with hash chaining (`prevHash` -> `hash`) per ADR-0003.
model AuditLog {
  id          BigInt       @id @default(autoincrement())
  hospitalId  String?      @map("hospital_id")
  actorUserId String?      @map("actor_user_id")
  actorRole   String?      @map("actor_role")
  action      String
  resource    String
  resourceId  String?      @map("resource_id")
  outcome     AuditOutcome @default(SUCCESS)
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")
  requestId   String?      @map("request_id")
  payload     Json?
  prevHash    String?      @map("prev_hash")
  hash        String
  createdAt   DateTime     @default(now()) @map("created_at")

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([actorUserId])
  @@map("audit_log")
  @@schema("platform")
}
